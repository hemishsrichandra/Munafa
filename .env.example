# Required. No automatic database fallback. Supply actual local values privately.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/munafa
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/munafa_test
DATABASE_SCHEMA=public
APP_ENV=production
APP_ORIGINS=https://YOUR_HOST
# Legacy development access is forbidden in production. Never deploy a DEV_LOGIN_CODE.
ALLOW_DEV_LOGIN=0
DEV_LOGIN_CODE=
# Production-safe entry points. Set 0 to disable; unset defaults to 1.
ENABLE_PUBLIC_SIGNUP=1
ENABLE_PUBLIC_DEMO=1
# Total public demo stores allowed. No automatic deletion; see docs/AUTH-DEPLOYMENT.md.
PUBLIC_DEMO_MAX_STORES=500
# Public demo paid AI is OFF by default. Manual capture/help remain available.
PUBLIC_DEMO_AI_ENABLED=0
# Only set all four after reviewing provider costs and an explicit public-demo budget.
# Reservations are conservative configured caps, not verified provider invoice charges.
PUBLIC_DEMO_AI_REQUEST_RESERVE_PAISE=
PUBLIC_DEMO_AI_DAILY_RESERVE_LIMIT_PAISE=
PUBLIC_DEMO_AI_GLOBAL_DAILY_CALLS=
PUBLIC_DEMO_AI_STORE_DAILY_CALLS=
# Compose only; generate private values in your ignored .env.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=munafa
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_VISION_MODEL=gemma4

# Android build only. Public API URL, never an API key. Leave blank for same-origin PWA.
VITE_API_BASE=

# Unvalidated speech preview: disabled until the language/device matrix is reviewed.
ENABLE_SPEECH_PREVIEW=0
SARVAM_STT_MODEL=saaras:v3

# P2 readiness only. Flags request activation; missing prerequisites remain blocked.
# No flag enables an order, lender submission, underwriting or peer statistic.
ENABLE_P2_PROCUREMENT=0
ENABLE_P2_FINANCIAL_PLANNING=0
ENABLE_P2_BENCHMARKING=0

# Optional release verification only: directory containing supported pg_dump/pg_restore.
# PG_BIN=
# RELEASE_EVIDENCE_DIR=artifacts/test-evidence

# Optional private backup worker only. No service is provisioned; configure privately.
BACKUP_DATABASE_URL=
BACKUP_SCHEMA=public
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_PREFIX=munafa-backups
BACKUP_S3_ENCRYPTION=AES256
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_MAX_BYTES=1073741824
# Leave disabled until the documented retention plan and verified backup are approved.
SECURITY_RETENTION_APPLY=0
# Only for explicitly confirmed restore into a newly generated disposable database.
RESTORE_TEST_ADMIN_URL=

# Optional read-only retention planning, separate from app DATABASE_URL.
RETENTION_DATABASE_URL=
