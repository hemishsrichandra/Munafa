# Keep keys server-side. The prototype works without credentials.
SARVAM_API_KEY=
# Native Sarvam model structures pasted invoice text.
SARVAM_CHAT_MODEL=sarvam-105b
# Sarvam-hosted vision model for invoice images; subject to account access.
SARVAM_VISION_MODEL=gemma4
MUNAFA_DB=.data/munafa.db
# Seed three clearly synthetic ledger examples on an empty database.
MUNAFA_SEED=1
