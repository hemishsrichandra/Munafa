# Separate PostgreSQL databases only. Never point at Munafa's application database.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/regpulse
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/regpulse_test
DATABASE_SCHEMA=public
APP_ENV=development
ALLOW_DEV_LOGIN=0
APP_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
# Public browser API base; never secrets in VITE_ settings.
VITE_API_BASE=
# Provider keys not needed for this inherited foundation. Add server-only
# configuration after official API selection and verification during the event.
